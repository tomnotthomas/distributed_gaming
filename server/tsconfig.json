{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here only for RTCSessionDescriptionInit / RTCIceCandidateInit in
    // protocol.ts. The server relays those payloads without reading them; it
    // uses no DOM APIs.
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    // @swiff/rank ships TypeScript source with .ts imports, which Node runs
    // directly (type stripping). This lets tsc read them.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
