---
config:
  theme: base
  flowchart:
    curve: basis
    htmlLabels: true
  themeVariables:
    fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
    fontSize: 14px
    edgeLabelBackground: "#ffffff"
    lineColor: "#333333"
    primaryTextColor: "#222222"
  themeCSS: >-
    .edgeLabel, .edgeLabel p, .edgeLabel span, .labelBkg { background: #fff !important; background-color: #fff !important; }
    .edgeLabel p, .edgeLabel span { color: #555; font-size: 13px; }
    .edgeLabel rect { fill: #fff !important; opacity: 1 !important; }
    svg, text, span, p, div { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important; }
---
flowchart LR
  Owner["Owner"]
  Installer["Swiff installer"]
  Service["Swiff background service<br/>holds the machine key"]
  subgraph Account["Separate Windows account"]
    Streamer["Streamer · capture + WebRTC<br/>short-lived session key"]
    Steam["Steam"]
  end
  Wiped["Account wiped"]
  subgraph Platform["Swiff platform"]
    API["Host API"]
    DB[("Database · Postgres (Neon)")]
    S3[("Save storage · S3")]
  end
  subgraph Connect["Connecting host and renter"]
    direction TB
    SIG["Connection setup<br/>swaps public addresses"]
    STUN
    TURN
  end
  STUN["STUN"]
  TURN["TURN relay"]
  Renter["Renter"]

  Owner --> Installer
  Installer -- "creates the account" --> Account
  Installer --> Service
  Service -- "session start · launches<br/>with the session key" --> Streamer
  Service -- "session end" --> Wiped
  Steam -- "game screen" --> Streamer
  Service -- "available now · heartbeat<br/>session started / ended" --> API
  API -- "write" --> DB
  Service -- "session start · download saves<br/>session end · upload saves, then wipe" --> S3
  Service -- "POST /api/machines/:id/session<br/>machine key → session key" --> SIG
  Streamer <-- "WebSocket · register + session key<br/>SDP/ICE" --> SIG
  SIG <-- "WebSocket · join<br/>SDP/ICE" --> Renter
  Streamer -. "my public address?" .-> STUN
  Streamer -. "fallback" .-> TURN
  TURN -.- Renter
  Streamer <== "video + audio + input" ==> Renter

  classDef owner fill:#e8f1fb,stroke:#6d9ed3,color:#0b2a4a
  classDef session fill:#fdf1dc,stroke:#e0a458,color:#8a5300
  classDef platform fill:#f7f7f7,stroke:#999,stroke-dasharray:4 3,color:#444
  class Owner,Installer,Service owner
  class Streamer,Steam,Wiped,Renter session
  class API,DB,S3,SIG,STUN platform
  classDef turn fill:#fdf1dc,stroke:#e0a458,color:#8a5300
  class TURN turn
  style Account fill:#fffaf0,stroke:#e0a458,color:#8a5300
  style Platform fill:#ffffff,stroke:#ccc,color:#444
  style Connect fill:#ffffff,stroke:#ccc,color:#444
