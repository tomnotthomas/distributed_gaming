---
config:
  theme: base
  flowchart:
    curve: basis
    htmlLabels: true
  themeVariables:
    fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
    fontSize: 14px
    edgeLabelBackground: "#ffffff"
    lineColor: "#333333"
    primaryTextColor: "#222222"
  themeCSS: >-
    .edgeLabel, .edgeLabel p, .edgeLabel span, .labelBkg { background: #fff !important; background-color: #fff !important; }
    .edgeLabel p, .edgeLabel span { color: #555; font-size: 13px; }
    .edgeLabel rect { fill: #fff !important; opacity: 1 !important; }
    svg, text, span, p, div { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important; }
---
flowchart LR
  Renter["Renter"]
  SteamID["Steam"]
  TURN["TURN relay"]
  STUN["STUN"]
  TURNnote["carries the stream when<br/>the direct path is blocked"]
  STUNnote["tells each side how it looks<br/>from the outside"]
  TURN -.- TURNnote
  STUN -.- STUNnote

  subgraph PC["Gaming PC"]
    direction TB
    SVC["Background service<br/>holds the machine key"]
    STR["Streamer<br/>separate Windows account<br/>short-lived session key"]
  end

  subgraph Platform["Swiff platform · one server"]
    API["Booking API"]
    HAPI["Host API"]
    MM["Matching<br/>queued bookings only<br/>on every change + timer for<br/>the next deadline"]
    DB[("Database · SQLite for now")]
    S3[("Save storage · S3")]
    SIG["Connection setup<br/>swaps public addresses"]
  end

  subgraph Data["Database · stored data"]
    direction TB
    T1["machines<br/>id (PK)<br/>owner_id (FK)<br/>gpu · cpu · price<br/>status<br/>available_until<br/>last_seen_at"]
    T2["bookings<br/>id (PK)<br/>renter_id (FK)<br/>game_id (FK)<br/>minutes · status<br/>queued → matched →<br/>claimed → playing → ended"]
    T3["reservations<br/>id (PK)<br/>booking_id (FK)<br/>machine_id (FK)<br/>expires_at"]
    T4["sessions<br/>id (PK)<br/>booking_id (FK)<br/>machine_id (FK)<br/>started_at · ended_at<br/>expires_at · price<br/>ticket_id"]
    T5["saves<br/>id (PK)<br/>renter_id (FK)<br/>game_id (FK)<br/>s3_key · updated_at"]
    T1 ~~~ T2 ~~~ T3 ~~~ T4 ~~~ T5
  end


  Renter -- "sign in" --> SteamID
  Renter -- "HTTPS · ranked PCs for a game<br/>book the picked PC or join the queue<br/>claim" --> API
  API -- "rank live PCs · reserve the pick<br/>store booking · claimed" --> DB
  API -- "event stream (SSE)<br/>booking status · claim countdown<br/>page heartbeat every 15 s = renter present" --> Renter
  API -- "no PC free: queue" --> MM
  MM -- "reserve a free PC<br/>for the oldest booking" --> DB
  API -. "join ticket signed with ROOM_SECRET<br/>checked here, no call needed" .- SIG
  Renter <-- "WebSocket · join ticket<br/>SDP/ICE + machine ready" --> SIG
  SVC <-- "WebSocket · machine key<br/>open socket = PC online<br/>session-claimed" --> SIG
  SVC -- "POST /api/machines/:id/session<br/>machine key → session key" --> SIG
  SVC -- "launches with the session key" --> STR
  STR <-- "WebSocket · session key" --> SIG
  SVC -- "available now · report on change<br/>session started / ended" --> HAPI
  HAPI -- "write" --> DB
  SVC -- "download saves at start<br/>upload saves at end" --> S3
  Renter <== "WebRTC · one peer connection<br/>video + audio + input" ==> STR
  STR -. "fallback" .-> TURN
  Renter <-.- TURN
  STR -. "public address" .-> STUN
  Renter -. "public address" .-> STUN
  DB -.- Data

  classDef platform fill:#f7f7f7,stroke:#999,stroke-dasharray:4 3,color:#444
  classDef endpoint fill:#e8f1fb,stroke:#6d9ed3,color:#0b2a4a
  classDef turn fill:#fdf1dc,stroke:#e0a458,color:#8a5300
  classDef note fill:none,stroke:none,color:#666,font-style:italic
  classDef table fill:#fffbe8,stroke:#e0d58a,color:#333
  class API,HAPI,MM,DB,S3 platform
  class Renter,SVC,SIG,STUN,SteamID endpoint
  class STR,TURN turn
  class T1,T2,T3,T4,T5 table
  class TURNnote,STUNnote note
  style Platform fill:#ffffff,stroke:#ccc,color:#444
  style PC fill:#ffffff,stroke:#ccc,color:#444
  style Data fill:#ffffff,stroke:#ccc,color:#444
  linkStyle 0,1 stroke:#aaa,stroke-width:1px
