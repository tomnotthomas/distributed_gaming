{
  // The e2e specs are plain node + Playwright. Playwright transpiles without
  // typechecking, so this exists to give CI something to check them against.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["tests", "../playwright.config.ts"]
}
