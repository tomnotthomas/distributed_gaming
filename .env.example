# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real credential here.
#
# Read by the signaling server at startup and handed to both peers in
# `registered` and `joined` — see server/src/ice.ts. Neither the renter page nor
# the host .exe has to be rebuilt to change any of it.

# Port the signaling server listens on. Defaults to 8080.
PORT=8080

# The server's SQLite file, relative to server/, e.g. swiff.db.
# `npm run seed-requirements` fills its game_requirements table and needs it set.
DATABASE_PATH=

# --- Room access --------------------------------------------------------------
#
# Required. With either one missing the server refuses every gaming PC or every
# renter — there is no open mode. See server/src/access.ts.
#
# Signs renters' join tickets. At least 32 characters; make one with
#   openssl rand -base64 48
# Changing it invalidates every ticket already handed out.
ROOM_SECRET=

# One entry per gaming PC, `machine-id:sha256-of-its-key:owner-steam-id`,
# comma-separated. The owner's 17-digit Steam id keeps them from ever being
# matched to their own PC; an entry without one can be matched to anyone.
# `npm run machine-key -- <machine-id> <owner-steam-id>` prints the key (for the
# host app) and the entry to paste here. Only the hash lives on the server.
MACHINE_KEYS=

# Join links for renters: `npm run ticket -- <machine-id> [minutes] [origin]`.

# --- Renter sign-in -------------------------------------------------------------
#
# Required to sign in, and so to book. Signs the renter's sign-in session cookie
# after Steam sign-in — see server/src/signin.ts. At least 32 characters and not
# the same as ROOM_SECRET; make one with
#   openssl rand -base64 48
# Changing it signs every renter out.
SESSION_SECRET=

# --- TURN -------------------------------------------------------------------
#
# Only needed when the two peers cannot reach each other directly: symmetric
# NAT, carrier CGNAT (a phone hotspot is the usual way to hit this), or a
# network that only lets 443 out. On one LAN leave all of it blank — no TURN is
# configured and the server behaves exactly as it does without this file.
#
# There are two ways to supply it. The server checks them in this order.

# 1. MINTED (preferred) — the server generates short-lived credentials from your
#    long-term key and refreshes them before they expire. This is the
#    arrangement Cloudflare documents, and the only one that does not break
#    every time a ttl runs out.
#
#    Both values come from the TURN key you create at
#    dash.cloudflare.com -> Realtime -> TURN. The API token is the long-term
#    secret: it can mint unlimited credentials against your account, so it
#    belongs here and nowhere else — not in a commit, not pasted into a chat,
#    not in a terminal whose output is shared.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

#    Lifetime of each minted credential, in seconds. Defaults to 86400 (24h);
#    the server re-mints at 80% of it. Shorter is safer while developing.
# TURN_TTL_SECONDS=3600

# 2. STATIC — a pair generated by hand, or any other TURN provider. Whatever is
#    here is served until the process restarts. Also used as the fallback if the
#    very first mint above fails, so a provider outage at boot degrades to this
#    rather than to nothing.
#
#    Comma-separated. Include the TCP/443 entries, not just UDP: they are the
#    ones that work on networks where everything but HTTPS is blocked.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

#    Generate a pair by hand like this, if you would rather not give the server
#    the long-term token:
#
#      curl https://rtc.live.cloudflare.com/v1/turn/keys/$TURN_KEY_ID/credentials/generate-ice-servers \
#        --header "Authorization: Bearer $TURN_KEY_API_TOKEN" \
#        --header "Content-Type: application/json" \
#        --data '{"ttl": 3600}'
#
#    What comes back is only a short-lived username/credential, and every
#    renter's browser is given it anyway — phase 1 has no auth, so whoever can
#    reach the signaling server can read it.

# --- A note on cost ----------------------------------------------------------
#
# Relay is metered. At DEFAULT_CAPTURE.maxBitrate (10 Mbit/s) a session burns
# roughly 4.5 GB an hour, so turn that down while testing. Direct connections
# (`host` or `srflx` in the status line) cost nothing — TURN is only the
# fallback when there is no direct path.
