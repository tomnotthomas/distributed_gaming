#!/usr/bin/env python3
"""Lanterel OS's LAN lockout, checked as root inside the VM test build in the
home network vm/lan-test.sh puts the VM in:

    selftest-lan lan                  the renter reaches the internet, nothing of the home network
    selftest-lan lan-firewall-broken  the firewall did not load: no network comes up
    selftest-lan probe                (as the renter) runs the probes on stdin, prints their outcomes

Every result is a SWIFF-SELFTEST line on the serial console, as from selftest.
The home network (vm/lan-fixture.py): the router at 192.168.77.1, fe80::1 and
2001:db8:77::1 hands out addresses, answers DNS and serves admin pages on 80
and 443, also on its public address 203.0.113.7, which the stream's STUN
servers (resolved to 198.51.100.30) report; another device at 192.168.77.50, fe80::50 and 2001:db8:77::50 serves
a page and answers mDNS, SSDP, LLMNR and NetBIOS; the internet beyond the
router, 198.51.100.10 and 2001:db8:ffff::10, serves a page and echoes UDP.
"""

import errno
import ipaddress
import json
import os
import socket
import struct
import subprocess
import sys
import threading
import time

ADMIN = "swiff-router-admin"
DEVICE = "swiff-lan-device"
INTERNET = "swiff-internet"
INTERNET_UDP = "swiff-internet-udp"
DISCOVERED = "swiff-lan-discovered"
LAN6 = ipaddress.ip_network("2001:db8:77::/64")
PUBLIC = "203.0.113.7"
# The port the VM listens on while vm/lan-test.sh connects from the other device.
INBOUND_PORT = 8000
INBOUND_WINDOW = 15
# What a connect or send that the firewall refuses fails with: ICMP
# admin-prohibited (IPv4: no route to host, IPv6: permission denied), or the
# packet dropped on its way out.
REFUSED = {errno.EHOSTUNREACH, errno.EACCES, errno.EPERM, errno.ENETUNREACH}

# Who probes, how, where, what answers there, and whether the firewall stops it.
# {if} is the VM's network interface, for link-local addresses.
PROBES = [
    ("router-admin", "renter", "tcp", "192.168.77.1", 80, ADMIN, True),
    ("router-admin-https", "renter", "tcp", "192.168.77.1", 443, ADMIN, True),
    ("router-admin-as-root", "root", "tcp", "192.168.77.1", 80, ADMIN, True),
    ("router-admin-ipv6", "renter", "tcp", "2001:db8:77::1", 80, ADMIN, True),
    ("router-admin-link-local", "renter", "tcp", "fe80::1%{if}", 80, ADMIN, True),
    ("router-admin-wan", "renter", "tcp", PUBLIC, 80, ADMIN, True),
    ("router-admin-wan-https", "renter", "tcp", PUBLIC, 443, ADMIN, True),
    ("router-admin-wan-as-root", "root", "tcp", PUBLIC, 80, ADMIN, True),
    ("router-admin-wan-https-as-root", "root", "tcp", PUBLIC, 443, ADMIN, True),
    ("router-ping", "root", "ping", "192.168.77.1", 0, "echo-reply", True),
    ("lan-device", "renter", "tcp", "192.168.77.50", 80, DEVICE, True),
    ("lan-device-ipv6", "renter", "tcp", "2001:db8:77::50", 80, DEVICE, True),
    ("lan-device-link-local", "renter", "tcp", "fe80::50%{if}", 80, DEVICE, True),
    ("mdns", "renter", "udp", "224.0.0.251", 5353, f"{DISCOVERED} mdns", True),
    ("mdns-ipv6", "renter", "udp", "ff02::fb%{if}", 5353, f"{DISCOVERED} mdns", True),
    ("ssdp", "renter", "udp", "239.255.255.250", 1900, f"{DISCOVERED} ssdp", True),
    ("ssdp-ipv6", "renter", "udp", "ff02::c%{if}", 1900, f"{DISCOVERED} ssdp", True),
    ("llmnr", "renter", "udp", "224.0.0.252", 5355, f"{DISCOVERED} llmnr", True),
    ("llmnr-ipv6", "renter", "udp", "ff02::1:3%{if}", 5355, f"{DISCOVERED} llmnr", True),
    ("netbios", "renter", "udp", "192.168.77.255", 137, f"{DISCOVERED} netbios", True),
    ("dns", "renter", "dns", "internet.lanterel.test", 0, "198.51.100.10", False),
    ("internet", "renter", "tcp", "198.51.100.10", 80, INTERNET, False),
    ("internet-ipv6", "renter", "tcp", "2001:db8:ffff::10", 80, INTERNET, False),
    ("internet-udp", "renter", "udp", "198.51.100.10", 3478, INTERNET_UDP, False),
    ("internet-udp-ipv6", "renter", "udp", "2001:db8:ffff::10", 3478, INTERNET_UDP, False),
    ("internet-ping", "root", "ping", "198.51.100.10", 0, "echo-reply", False),
]


def say(*words):
    print("SWIFF-SELFTEST", *words, flush=True)


def check(name, ok, detail):
    say("PASS" if ok else "FAIL", name, detail)


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def ping(host):
    """One ICMP echo request; root only (a raw socket)."""
    with socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_ICMP) as s:
        s.settimeout(3)
        ident = os.getpid() & 0xFFFF
        header = struct.pack("!BBHHH", 8, 0, 0, ident, 1)
        payload = b"swiff-lan-test"
        total = sum(struct.unpack("!%dH" % ((len(header) + len(payload)) // 2), header + payload))
        total = (total >> 16) + (total & 0xFFFF)
        checksum = ~(total + (total >> 16)) & 0xFFFF
        s.sendto(struct.pack("!BBHHH", 8, 0, checksum, ident, 1) + payload, (host, 0))
        while True:
            packet, (source, _) = s.recvfrom(1024)
            icmp = packet[(packet[0] & 0x0F) * 4 :]
            if source == host and icmp[0] == 0 and struct.unpack("!H", icmp[4:6])[0] == ident:
                return "answer echo-reply"


def probe(kind, host, port):
    """What came of one probe:"answer <first line>", "refused <why>", "no-answer" or "error <why>"."""
    try:
        if kind == "tcp":
            with socket.create_connection((host, port), timeout=3) as s:
                s.settimeout(3)
                return "answer " + s.makefile().readline().strip()
        if kind == "udp":
            family, _, _, _, address = socket.getaddrinfo(host, port, type=socket.SOCK_DGRAM)[0]
            with socket.socket(family, socket.SOCK_DGRAM) as s:
                s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
                s.settimeout(3)
                s.sendto(b"swiff-lan-test", address)
                return "answer " + s.recv(512).decode().strip()
        if kind == "ping":
            return ping(host)
        if kind == "dns":
            return "answer " + socket.getaddrinfo(host, None, socket.AF_INET)[0][4][0]
    except (socket.timeout, TimeoutError):
        return "no-answer"
    except socket.gaierror as e:
        return f"error {e}"
    except OSError as e:
        return ("refused " if e.errno in REFUSED else "error ") + (e.strerror or str(e))
    raise ValueError(kind)


def outcomes(probes):
    """Runs the probes, each as its user (the renter's in one unprivileged process)."""
    found = {p[0]: probe(*p[2:5]) for p in probes if p[1] == "root"}
    mine = [p for p in probes if p[1] == "renter"]
    res = subprocess.run(
        ["setpriv", "--reuid=renter", "--regid=renter", "--init-groups", "--no-new-privs", "--", sys.argv[0], "probe"],
        input=json.dumps(mine), capture_output=True, text=True,
    )
    # Without the renter's outcomes, a blocked probe would pass as unanswered.
    if res.returncode != 0 or not res.stdout:
        check("renter-probes-ran", False, f"exit status {res.returncode}: {res.stderr.strip()[-300:] or 'no output'}")
        raise SystemExit("the renter's probes did not run")
    found.update(json.loads(res.stdout))
    return found


def expected(round_, kind, host, answer, blocked):
    """Whether an outcome is what this round expects of the probe."""
    if round_ == "control" or not blocked:
        return lambda o: o == f"answer {answer}"
    # A connection fails at once, but to a link-local IPv6 address it times
    # out: the kernel's ICMPv6 refusal does not reach the local socket. A ping
    # or a datagram to a multicast or broadcast address may be refused or just
    # get no answer.
    if kind == "tcp" and "%" not in host:
        return lambda o: o.startswith("refused ")
    return lambda o: not o.startswith("answer ")


def probes_round(round_, link):
    """One round of the probe table: with the firewall, or without it as the control."""
    probes = [(n, who, kind, host.format(**{"if": link}), port, answer, blocked) for n, who, kind, host, port, answer, blocked in PROBES]
    found = outcomes(probes)
    for name, _, kind, host, port, answer, blocked in probes:
        verb = "blocked" if blocked else "works"
        label = f"{name}-{verb}" if round_ == "firewall" else f"control-{name}"
        o = found.get(name, "not run")
        # The IPv6 default route is sometimes gone for a few seconds after a
        # router advertisement refreshes it, also with the firewall removed,
        # until the next one. The firewall never makes a destination
        # unreachable: try again once the route is back.
        if not blocked and o == "refused Network is unreachable":
            for _ in range(60):
                if subprocess.run(["ip", "route", "get", host], capture_output=True).returncode == 0:
                    break
                time.sleep(1)
            say("INFO", f"{name}-retried", "no route to it at first; again once the router's next advertisement restored it")
            o = outcomes([p for p in probes if p[0] == name])[name]
        ok = expected(round_, kind, host, answer, blocked)(o)
        check(label, ok, f"{kind} {host} {port or ''} -> {o}".replace("  ", " "))
        if not ok and not blocked:
            for cmd in (["ip", "-6", "route"], ["ip", "-6", "neigh"], ["ip", "route", "get", host], ["journalctl", "-b", "-o", "short-monotonic", "-u", "systemd-networkd", "-n", "40", "--no-pager"]):
                for line in run(*cmd).splitlines() or ["(nothing)"]:
                    say("INFO", f"{name}-diagnosis", " ".join(cmd[:3]), line)


def inbound(round_, link):
    """Listens while vm/lan-test.sh connects from the other device; says how many got through."""
    accepted = []
    with socket.socket(socket.AF_INET6, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("::", INBOUND_PORT))
        s.listen()
        s.settimeout(0.5)
        v4 = run("sh", "-c", f"ip -4 -o addr show dev {link} scope global | awk '{{ print $4 }}' | cut -d/ -f1 | head -n1")
        v6 = run("sh", "-c", f"ip -6 -o addr show dev {link} scope global | awk '{{ print $4 }}' | cut -d/ -f1 | grep '^2001:db8:77:' | head -n1")
        say("LAN-INBOUND", round_, v4, v6, INBOUND_PORT)
        end = time.monotonic() + INBOUND_WINDOW
        while time.monotonic() < end:
            try:
                conn, peer = s.accept()
                accepted.append(peer[0])
                conn.close()
            except (socket.timeout, TimeoutError):
                pass
    if round_ == "firewall":
        check("inbound-from-lan-blocked", not accepted, f"connections accepted: {accepted or 'none'}")
    else:
        check("control-inbound-from-lan", bool(accepted), f"connections accepted: {accepted or 'none'}")


def nft_set(name):
    return run("nft", "list", "set", "inet", "swiff", name)


def elements(name):
    """A set's elements as nft prints them, or "-" when it has none."""
    text = nft_set(name)
    return text.split("elements = {", 1)[1].split("}", 1)[0].strip() if "elements = {" in text else "-"


def network_ready():
    """DHCP and the router advertisement are in, a route leads to the internet,
    and swiff-netguard has filled its sets from them."""
    routes = all(subprocess.run(["ip", "route", "get", a], capture_output=True).returncode == 0 for a in ("198.51.100.10", "2001:db8:ffff::10"))
    return routes and "192.168.77.1" in nft_set("gateway4") and "fe80::1" in nft_set("gateway6") and "2001:db8:77::/64" in nft_set("onlink6")


def lan():
    for _ in range(120):
        if network_ready():
            break
        time.sleep(1)
    link = run("sh", "-c", "ip -4 route show default | awk '{ print $5; exit }'")
    check("network-ready", network_ready(), " / ".join(run("ip", f"-{v}", "route", "show", "default") or f"no IPv{v} default route" for v in (4, 6)))
    say("INFO", "link", link, run("ip", "-br", "addr", "show", "dev", link) if link else "none")
    # swiff-netguard asks STUN once DNS works, on its next run at the latest.
    for _ in range(60):
        if PUBLIC in nft_set("wan4"):
            break
        time.sleep(1)
    say("INFO", "netguard", " / ".join(f"{s}: {elements(s)}" for s in ("gateway4", "dns4", "onlink4", "gateway6", "onlink6", "wan4")))
    check("public-address-learned", elements("wan4") == PUBLIC, f"wan4: {elements('wan4')}")
    check("firewall-loaded", run("systemctl", "is-active", "nftables.service") == "active", "nftables.service " + run("systemctl", "is-active", "nftables.service"))
    lease = run("sh", "-c", f"ip -4 -o addr show dev {link} | awk '{{ print $4 }}'") if link else ""
    check("dhcp-from-router", lease.startswith("192.168.77."), f"{link}: {lease or 'no address'}")
    v6 = run("ip", "-6", "-o", "addr", "show", "scope", "global")
    check("ipv6-from-router", "2001:db8:77:" in v6, "global IPv6 in 2001:db8:77::/64" if "2001:db8:77:" in v6 else "none")
    # The OS answers no discovery itself (systemd-resolved: no LLMNR, no mDNS).
    listening = run("ss", "-Hlnu")
    ports = sorted({line.split()[3].rsplit(":", 1)[1] for line in listening.splitlines() if len(line.split()) > 3} & {"137", "138", "1900", "5353", "5355"})
    check("no-discovery-listeners", not ports, f"UDP ports open for discovery: {' '.join(ports) or 'none'}")
    if not link:
        return

    probes_round("firewall", link)
    inbound("firewall", link)
    # Renewing the lease asks the router directly (DHCP, unicast); vm/lan-test.sh counts its answers.
    run("networkctl", "renew", link)
    time.sleep(3)
    say("INFO", "dhcp-renewed", link)

    run("nft", "delete", "table", "inet", "swiff")
    probes_round("control", link)
    inbound("control", link)
    reload = subprocess.run(["sh", "-c", "nft -f /etc/nftables.conf && /usr/libexec/swiff/netguard"], capture_output=True, text=True)
    again = outcomes([p for p in PROBES if p[0] in ("router-admin", "router-admin-wan")])
    check("blocked-after-reload", reload.returncode == 0 and all(o.startswith("refused ") for o in again.values()), f"192.168.77.1:80 -> {again['router-admin']}, {PUBLIC}:80 -> {again['router-admin-wan']}")


def firewall_broken():
    # Long enough for DHCP and a router advertisement, had anything asked.
    time.sleep(30)
    say("INFO", "cmdline", run("cat", "/proc/cmdline"))
    nft_state = run("systemctl", "is-failed", "nftables.service")
    check("firewall-failed", nft_state == "failed" and run("nft", "list", "tables") == "", f"nftables.service {nft_state}; tables: {run('nft', 'list', 'tables') or 'none'}")
    networkd = run("systemctl", "show", "-P", "ActiveState", "systemd-networkd.service")
    check("networkd-not-started", networkd != "active", f"systemd-networkd.service {networkd}")
    links = json.loads(run("ip", "-j", "addr") or "[]")
    up = [f"{l['ifname']} {l.get('operstate')} {' '.join(a['local'] for a in l.get('addr_info', []))}".strip() for l in links if l["ifname"] != "lo"]
    configured = [l["ifname"] for l in links if l["ifname"] != "lo" and (l.get("addr_info") or "UP" in l.get("flags", []))]
    check("no-link-up", up and not configured, "; ".join(up) or "no network interface")
    routes = run("ip", "route", "show", "default") + run("ip", "-6", "route", "show", "default")
    check("no-default-route", routes == "", routes or "none")
    o = outcomes([p for p in PROBES if p[0] == "internet"])["internet"]
    check("internet-unreachable", not o.startswith("answer "), f"198.51.100.10:80 -> {o}")


def main():
    if sys.argv[1] == "probe":
        print(json.dumps({p[0]: probe(*p[2:5]) for p in json.load(sys.stdin)}))
    elif sys.argv[1] == "lan":
        lan()
    elif sys.argv[1] == "lan-firewall-broken":
        firewall_broken()
    else:
        raise SystemExit(f"unknown phase {sys.argv[1]}")


main()
