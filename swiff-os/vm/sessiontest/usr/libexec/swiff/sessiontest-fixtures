#!/bin/bash
# VM session test build only. What the test plays around the PC, from the
# fixture disk vm/session-harness.mjs writes: the test server's address for
# sessiontest-forward, and the sign-in codes the stand-in Steam shows. Nothing
# of swiff-hostd's: its config and machine key come from the owner's app's
# provisioning on the keep partition, as on a real PC (swiff-provision).
set -eu

fix=/run/swiff-sessiontest/fixtures
install -d -m 0755 /run/swiff-sessiontest
install -d -m 0700 "$fix"
for _ in $(seq 300); do
	[ -e /dev/disk/by-label/SWIFFSESS ] && break
	sleep 0.1
done
mount -o ro LABEL=SWIFFSESS "$fix"
install -m 0600 "$fix/forward" /run/swiff-sessiontest/forward
install -d -m 0755 /run/swiff-sessiontest/qr
install -m 0644 "$fix"/qr/* /run/swiff-sessiontest/qr/
umount "$fix"
echo "SWIFF-SESSIONTEST INFO fixtures"
