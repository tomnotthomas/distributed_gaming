#!/usr/bin/env python3
"""VM session test build only: the test's platform server on 127.0.0.1:8080.

swiff-hostd takes plain ws:// only from a server on this machine, since its
machine key rides on it, and hands the streamer the same URL. The test's
server runs on the host, at the address in /run/swiff-sessiontest/forward, so
this forwards the loopback port to it. Everything else, the firewall included,
is as on a real PC: this connection leaves the VM like any other, and the
renter's media goes through the TURN relay, not through here.
"""

import asyncio

HOST, PORT = open("/run/swiff-sessiontest/forward").read().split()


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except ConnectionError:
        pass
    finally:
        writer.close()


async def handle(client_reader, client_writer):
    try:
        server_reader, server_writer = await asyncio.open_connection(HOST, int(PORT))
    except OSError:
        client_writer.close()
        return
    await asyncio.gather(pipe(client_reader, server_writer), pipe(server_reader, client_writer))


async def main():
    server = await asyncio.start_server(handle, "127.0.0.1", 8080)
    async with server:
        await server.serve_forever()


asyncio.run(main())
