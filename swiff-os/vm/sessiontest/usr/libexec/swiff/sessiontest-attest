#!/bin/sh
# VM session test build only: swiff-hostd's state.attestCommand. It runs the
# image's own attestation client, swiff-attest (a TPM quote to the server's TPM
# verifier), passes on the host certificate it prints, and counts each one in
# /run/swiff-sessiontest/attested for sessiontest-monitor.
set -eu
out=$(/usr/libexec/swiff/swiff-attest)
counter=/run/swiff-sessiontest/attested
count=$(cat "$counter" 2> /dev/null || echo 0)
echo $((count + 1)) > "$counter"
printf '%s\n' "$out"
