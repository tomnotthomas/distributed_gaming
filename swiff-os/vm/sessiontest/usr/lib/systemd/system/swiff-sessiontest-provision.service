# VM session test build only (mkosi --profile=sessiontest). Gives swiff-hostd
# what the owner's app would give a real PC: its config and machine key.
[Unit]
Description=Lanterel OS session test: this machine's config from the fixture disk
After=local-fs.target
Before=swiff-hostd.service swiff-sessiontest-forward.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/swiff/sessiontest-provision
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
