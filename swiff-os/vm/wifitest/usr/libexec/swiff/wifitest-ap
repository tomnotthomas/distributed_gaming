#!/bin/bash
# VM Wi-Fi test build only. The Wi-Fi around the PC, by the phase on the
# fixture disk vm/wifi-test.sh writes:
#   wifi   two simulated radios (mac80211_hwsim): one is the PC's adapter, the
#          other, in a network namespace of its own, the owner's access point
#          (hostapd, WPA2-PSK) with its DHCP and DNS server (dnsmasq)
#   no-ap  the PC's adapter, and no access point in reach
#   none   no Wi-Fi adapter at all
set -eu

fix=/run/swiff-wifitest
install -d -m 0700 "$fix"
for _ in $(seq 300); do
	[ -e /dev/disk/by-label/SWIFFWIFI ] && break
	sleep 0.1
done
mount -o ro LABEL=SWIFFWIFI "$fix"
phase=$(cat "$fix/phase")
echo "SWIFF-WIFITEST INFO phase $phase"
[ "$phase" != none ] || exit 0

modprobe mac80211_hwsim radios=2
for _ in $(seq 50); do
	[ "$(ls /sys/class/ieee80211 | wc -l)" = 2 ] && break
	sleep 0.1
done
[ "$phase" = wifi ] || exit 0

ap=$(ls /sys/class/ieee80211 | sort -V | tail -n1)
ip netns add ap
iw phy "$ap" set netns name ap
dev=$(ip netns exec ap iw dev | awk '$1 == "Interface" { print $2; exit }')
ssid=$(cat "$fix/ssid-hex")
# The key hostapd checks the PC against: derived from the passphrase here, so
# it matches only if swiff-provision derived iwd's key from the passphrase as it was given.
psk=$(python3 -c 'import hashlib, sys
print(hashlib.pbkdf2_hmac("sha1", open(sys.argv[1], "rb").read(), bytes.fromhex(sys.argv[2]), 4096, 32).hex())' \
	"$fix/passphrase" "$ssid")
cat > /run/hostapd.conf <<CONF
interface=$dev
driver=nl80211
ssid2=$ssid
hw_mode=g
channel=6
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_psk=$psk
CONF
ip netns exec ap ip link set lo up
ip netns exec ap hostapd -B -P /run/hostapd.pid /run/hostapd.conf
ip netns exec ap ip addr add 203.0.113.1/24 dev "$dev"
ip netns exec ap dnsmasq --conf-file=/dev/null --user=root --no-resolv --no-hosts \
	--interface="$dev" --bind-interfaces --pid-file=/run/dnsmasq.pid --dhcp-leasefile=/run/dnsmasq.leases \
	--dhcp-range=203.0.113.10,203.0.113.50,255.255.255.0,1h \
	--address=/wifitest.lanterel.example/203.0.113.1
echo "SWIFF-WIFITEST INFO access-point $dev in netns ap"
