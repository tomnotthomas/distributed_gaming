# swiff-hostd, the rental-mode agent. Runs as root: it holds the machine key,
# opens the persistent state, starts the streamer as its own user
# (swiff-stream) for each renter session, and restarts the machine. The image
# installs it (image/stage.sh) as one bundled file for Ubuntu's Node.
#
# It is offered only once the firewall is up and the games library is checked,
# and it runs only on a machine the owner's app provisioned: swiff-provision
# writes its config for this boot (machine id, key file, server) from the
# image's own settings (/usr/lib/swiff/hostd.json).
[Unit]
Description=Lanterel rental-mode agent
Wants=network-online.target swiff-esp.service
After=network-online.target nftables.service swiff-hwcheck.service swiff-games.service swiff-esp.service swiff-provision.service
Requires=nftables.service swiff-games.service
ConditionPathExists=/var/lib/swiff/hostd.json

[Service]
Environment=SWIFF_HOSTD_CONFIG=/var/lib/swiff/hostd.json
# Error reports to PostHog: LANTEREL_POSTHOG_KEY and LANTEREL_POSTHOG_HOST, in
# the file Lanterel Host writes onto Lanterel OS's ESP at install, never in the
# image source (README, "Error reports"); swiff-esp.service mounts the ESP. The
# agent reads only those two names from it, and checks them: without the file
# it reports nothing. Not an EnvironmentFile: Windows can write the ESP.
Environment=LANTEREL_ERROR_TRACKING_FILE=/run/swiff/esp/LANTEREL.ENV
ExecStart=/usr/bin/node /usr/lib/swiff/hostd/swiff-hostd.mjs
Restart=on-failure
RestartSec=5
# The control socket's directory: root's alone.
RuntimeDirectory=swiff-hostd
RuntimeDirectoryMode=0700
PrivateTmp=yes
# Not ProtectHome=, which would also hide /run/user: the streamer it starts
# reaches the renter's PipeWire socket there.
InaccessiblePaths=-/home -/root
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_ALG

[Install]
WantedBy=multi-user.target
