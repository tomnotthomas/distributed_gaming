#!/bin/sh
# Installs the Steam client and the 32-bit graphics libraries its 32-bit games
# use. They need the i386 architecture, which mkosi 20's own package install
# cannot enable, so it is done here with the image's apt against the same
# pinned snapshot mirror. Then NVIDIA: Canonical's signed open kernel modules,
# and the check that NVIDIA's driver, which the owner installs, is the one
# /usr/lib/swiff/nvidia-driver names.
set -eu

dpkg --add-architecture i386
apt-get update

# Accept the Steam licence non-interactively (the renter accepts Valve's terms
# when they sign in with their own account).
for owner in steam steam-installer; do
	echo "$owner steam/question select I AGREE" | debconf-set-selections
	echo "$owner steam/license note ''" | debconf-set-selections
done

DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
	steam-installer \
	steam-libs-i386:i386 \
	mesa-vulkan-drivers:i386 \
	libgl1-mesa-dri:i386 \
	libnvidia-egl-wayland1:i386

apt-get clean

# NVIDIA's driver, as apt resolves it for this image: the owner's host app
# downloads exactly these packages, and nothing is installed here.
# mkosi.finalize compares them with /usr/lib/swiff/nvidia-driver and removes
# this list. Each line: mirror, SHA-256, size, path under the mirror, package.
mkdir -p /usr/lib/swiff
apt-get install --print-uris -qq --no-install-recommends \
	nvidia-kernel-common-595 libnvidia-gl-595 libnvidia-gl-595:i386 \
	libnvidia-extra-595 libnvidia-encode-595 nvidia-utils-595 |
	while read -r url file size _; do
		url=${url#\'}
		url=${url%\'}
		name=${file%%_*}
		rest=${file#*_}
		version=$(printf %s "${rest%_*}" | sed 's/%3a/:/g')
		arch=${rest##*_}
		sha=$(apt-cache show --no-all-versions "$name:${arch%.deb}=$version" | awk '$1 == "SHA256:" { print $2; exit }')
		echo "${url%%/pool/*} $sha $size pool/${url#*/pool/} $name"
	done > /usr/lib/swiff/nvidia-driver.resolved

# Canonical's build of NVIDIA's open kernel modules (dual MIT/GPL) for the
# image's kernel, signed with a Canonical key that kernel has built in, so they
# load under lockdown and module.sig_enforce. Unpacked on their own: installing
# the package would pull in NVIDIA's proprietary firmware and userspace, which
# the owner installs instead. mkosi.finalize checks the kernel and the signer.
# To move to another driver series, change 595 here, in nvidia-driver and in
# desktop/src/rental.ts (SWIFF_OS_NVIDIA).
set -- /usr/lib/modules/*
[ $# = 1 ] || {
	echo "mkosi.postinst.chroot: expected one kernel, found: $*" >&2
	exit 1
}
kernel=${1##*/}
modules=$(mktemp -d)
(cd "$modules" && apt-get download "linux-modules-nvidia-595-open-$kernel")
dpkg-deb -x "$modules"/linux-modules-nvidia-595-open-*.deb "$modules/tree"
cp -a "$modules/tree/lib/modules/$kernel/kernel/nvidia-595-open" "/usr/lib/modules/$kernel/kernel/"
rm -rf "$modules"

# Mount points on the read-only root.
mkdir -p /srv/games /srv/games-lower
