# Ephemeral scratch: plain dm-crypt under a key read from /dev/urandom at every
# boot and never stored, then formatted fresh (tmp=). After a reboot nothing
# written in the previous boot can be read back, by anyone.
swiff-scratch /dev/disk/by-partlabel/swiff-scratch /dev/urandom plain,cipher=aes-xts-plain64,size=512,sector-size=4096,tmp=ext4,discard
