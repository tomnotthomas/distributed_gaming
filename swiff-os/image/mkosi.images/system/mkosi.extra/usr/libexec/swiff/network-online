#!/bin/sh
# Lanterel OS's network, as the status screen shows it: online once a cable or
# Wi-Fi gives this PC a routable address, failed after a minute without one.
# network-online.target is reached at that verdict either way, and a network
# that comes later still turns the state online. The state is in
# /run/swiff/network, readable by everyone, replaced whole at each change:
#
#   STATE=connecting|online|failed
#   MEDIUM=wifi|ethernet   online: the link that is. Otherwise what it waits
#                          for: wifi when the owner's app handed over a Wi-Fi
#                          network, ethernet when it did not.
#   REASON=...             failed only:
#            wifi             the Wi-Fi network was not joined (out of reach, a
#                             changed passphrase, or no address from it)
#            no-wifi-adapter  Wi-Fi was handed over, but this PC has no Wi-Fi
#                             adapter Lanterel OS can drive
#            no-network       no Wi-Fi was handed over, and no cable gave an address
set -u

state=/run/swiff/network
timeout=60

# Replaces the state with KEY=VALUE lines.
report() {
	printf '%s\n' "$@" > "$state.new" && mv "$state.new" "$state"
}
# Waits for a routable address on any link, at most --timeout=S seconds (0: for
# ever). Without the notify socket: it would tell systemd it is ready as it starts.
wait_online() {
	env -u NOTIFY_SOCKET /usr/lib/systemd/systemd-networkd-wait-online --any --operational-state=routable "$@"
}
# The medium that carries the traffic, as networkd types it: a cable when one is
# online, as it has the lower route metric, Wi-Fi only otherwise.
medium() {
	networkctl list --no-legend --no-pager | awk '$4 == "routable" { if ($3 != "wlan") m = "ethernet"; else if (m == "") m = "wifi" } END { if (m != "") print m }'
}

want=ethernet
for network in /var/lib/iwd/*.psk /var/lib/iwd/*.open; do
	[ -e "$network" ] && want=wifi
done

report STATE=connecting MEDIUM=$want
if ! wait_online --timeout=$timeout; then
	reason=no-network
	if [ $want = wifi ]; then
		if [ -n "$(ls /sys/class/ieee80211 2> /dev/null)" ]; then reason=wifi; else reason=no-wifi-adapter; fi
	fi
	report STATE=failed MEDIUM=$want REASON=$reason
	systemd-notify --ready
	wait_online --timeout=0
fi
report STATE=online MEDIUM="$(medium)"
systemd-notify --ready
