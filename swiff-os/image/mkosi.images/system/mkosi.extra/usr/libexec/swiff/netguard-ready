#!/bin/sh
# Holds swiff-hostd and the renter session until swiff-netguard has filled its
# sets from a configured network, the home's public address included: waits
# for a default route, then runs it until the public address is learned,
# backing off up to 15 s between tries. swiff-netguard-ready.service gives up
# after its start timeout, and with it the agent and the session.
delay=1
until ip -4 route show default | grep -q . && /usr/libexec/swiff/netguard --require-wan; do
	sleep "$delay"
	[ "$delay" -ge 15 ] || delay=$((delay * 2))
	[ "$delay" -le 15 ] || delay=15
done
