#!/usr/bin/env python3
"""Prints the home's public IPv4 address, as the STUN servers the stream uses
(packages/rtc's DEFAULT_ICE_SERVERS) see it: one binding request (RFC 8489)
to each in turn until one answers. Exits non-zero when none does.
"""

import os
import socket
import struct
import sys

SERVERS = [("stun.l.google.com", 19302), ("stun1.l.google.com", 19302), ("stun.cloudflare.com", 3478)]
COOKIE = 0x2112A442
XOR_MAPPED_ADDRESS = 0x0020


def ask(host, port):
    """The XOR-MAPPED-ADDRESS one server answers with, or None."""
    txid = os.urandom(12)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(1)
        s.sendto(struct.pack("!HHI", 0x0001, 0, COOKIE) + txid, (socket.gethostbyname(host), port))
        data = s.recv(1024)
    kind, length, cookie = struct.unpack("!HHI", data[:8])
    if kind != 0x0101 or cookie != COOKIE or data[8:20] != txid:
        return None
    attrs = data[20 : 20 + length]
    while len(attrs) >= 4:
        attr, size = struct.unpack("!HH", attrs[:4])
        value = attrs[4 : 4 + size]
        if attr == XOR_MAPPED_ADDRESS and len(value) == 8 and value[1] == 0x01:
            return socket.inet_ntoa(struct.pack("!I", struct.unpack("!I", value[4:8])[0] ^ COOKIE))
        attrs = attrs[4 + (size + 3) // 4 * 4 :]
    return None


for host, port in SERVERS:
    try:
        address = ask(host, port)
    except (OSError, struct.error):
        continue
    if address:
        print(address)
        sys.exit(0)
sys.exit(1)
