#!/bin/sh
# Runs as the renter inside the logind session swiff-session.service opens.
# gamescope is the compositor and Steam the only client; there is nothing to
# switch to. (Driving Steam's QR login and launching straight into the game,
# so the renter never sees Steam's own UI, is a later stage.)
set -eu
# Ubuntu installs gamescope and the Steam launcher in /usr/games.
export PATH=/usr/games:/usr/bin
export XDG_SESSION_TYPE=wayland
exec gamescope --steam --fullscreen -- /usr/games/steam -gamepadui
