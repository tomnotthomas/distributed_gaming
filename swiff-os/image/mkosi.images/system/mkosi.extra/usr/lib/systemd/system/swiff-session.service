# The renter's whole UI: gamescope on tty1 running the Steam sign-in agent,
# which starts Steam at its sign-in window and, once the renter has signed in
# by QR code on Swiff's page, the game they booked (/usr/libexec/swiff/session,
# from steam/session). It runs as the unprivileged renter user. There is no
# display manager, desktop or login prompt; when the session ends it is simply
# started again. It never runs without the firewall, with VT switching open or
# without the verified games view.
[Unit]
Description=Lanterel renter session (gamescope + Steam sign-in)
After=systemd-user-sessions.service systemd-logind.service home.mount swiff-games.service nftables.service swiff-vtlock.service
Requires=home.mount nftables.service swiff-vtlock.service swiff-games.service
Conflicts=getty@tty1.service

[Service]
User=renter
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=~
# Steam's own UI lets whoever is at it start programs, so from here on
# nothing in the games library view can be trusted for promotion (report §8).
ExecStartPre=+/usr/libexec/swiff/verify close-seal
ExecStart=/usr/libexec/swiff/session
Restart=always
RestartSec=2s
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
