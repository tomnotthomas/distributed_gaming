{
  // Typechecks the tests the app build deliberately skips: they use node and
  // the jsdom matchers, which the renderer bundle has no business carrying.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@testing-library/jest-dom"],
    "noEmit": true
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "pc.d.cts", "tray-icon.d.cts"],
  "exclude": []
}
