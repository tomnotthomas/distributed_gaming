{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@swiff/rtc": ["../packages/rtc/src/index.ts"],
      "@swiff/error-tracking": ["../packages/error-tracking/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite.main.config.ts",
    "../packages/rtc/src",
    "../packages/error-tracking/src"
  ],
  // The app build typechecks the app; tsconfig.test.json covers the tests.
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test"]
}
