{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@swiff/ui": [
        "../packages/ui/src/index.ts"
      ],
      "@swiff/rtc": [
        "../packages/rtc/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "vite.config.ts",
    "../packages/*/src"
  ]
}
